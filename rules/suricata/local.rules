alert tcp $HOME_NET any -> any any (msg:"LAB Possible TCP port scan (many refused connections to one source)"; flags:+R; threshold:type both, track by_dst, count 15, seconds 2; classtype:attempted-recon; sid:1000001; rev:2; metadata:mitre_tactic_id TA0007, mitre_technique_id T1046;)
alert http any any -> $HOME_NET any (msg:"LAB SQL injection attempt: UNION SELECT in URI"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; classtype:web-application-attack; sid:1000002; rev:1; metadata:mitre_tactic_id TA0001, mitre_technique_id T1190;)